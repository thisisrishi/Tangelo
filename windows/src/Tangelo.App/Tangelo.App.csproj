<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Tangelo</AssemblyName>
    <RootNamespace>Tangelo.App</RootNamespace>
    <StartupObject>Tangelo.App.App</StartupObject>
    <ApplicationIcon>Assets\tangelo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Tangelo</Product>
    <Company>Tangelo</Company>
    <Copyright>© 2026 Rishi Raj Jaiswal</Copyright>
    <Description>Convert, edit and move files right where you drag them.</Description>
    <NoWarn>$(NoWarn);WPF0001;CA1416;WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only used for the tray icon and colour picker; keep its types out of global scope. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tangelo.Core\Tangelo.Core.csproj" />
    <ProjectReference Include="..\Tangelo.Platform.Windows\Tangelo.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\tray.ico" LogicalName="Tangelo.App.Assets.tray.ico" />
    <EmbeddedResource Include="Assets\tangelo.ico" LogicalName="Tangelo.App.Assets.tangelo.ico" />
    <None Include="..\..\models\u2netp.onnx" Link="models\u2netp.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\models\u2netp.onnx')" />
  </ItemGroup>
</Project>
